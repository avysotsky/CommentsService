<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.1.0.8</Version>
    <AssemblyVersion>1.1.0.8</AssemblyVersion>
    <FileVersion>1.1.0.8</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CommentsService.Application/CommentsService.Application.csproj" />
    <ProjectReference Include="../CommentsService.Infrastructure/CommentsService.Infrastructure.csproj" />
    <!-- Design-time EF startup tooling only; runtime persistence belongs to Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
