{
  "Runtime": {
    "InstanceId": "commentsservice",
    "HealthPort": 8080,
    "Realtime": {
      "Enabled": true,
      "MaximumConnections": 256,
      "SendTimeoutSeconds": 5,
      "KeepAliveSeconds": 20,
      "KeepAliveTimeoutSeconds": 10,
      "ReconnectDelayMilliseconds": 1000,
      "MaximumReconnectDelayMilliseconds": 30000
    },
    "Notifications": {
      "Capacity": 64,
      "MaximumAttempts": 3,
      "RetryDelayMilliseconds": 200
    },
    "Cache": {
      "Enabled": true,
      "LifetimeSeconds": 15,
      "Capacity": 128,
      "MaximumBytes": 16777216
    },
    "Logging": {
      "MinimumLevel": "Information",
      "Overrides": {},
      "Directory": "logs",
      "FileSizeLimitBytes": 10485760,
      "RetainedFileCountLimit": 14
    },
    "Database": {
      "Port": 5432,
      "TimeoutSeconds": 15,
      "CommandTimeoutSeconds": 30,
      "MaximumPoolSize": 100
    },
    "Limits": {
      "RootPageSize": 25,
      "DefaultListLimit": 25,
      "MaximumListLimit": 100,
      "UserNameMaxLength": 100,
      "EmailMaxLength": 254,
      "HomePageMaxLength": 2048,
      "TextMaxLength": 65536,
      "UserAgentMaxLength": 2048,
      "MarkupMaxDepth": 32,
      "MarkupMaxNodes": 4096,
      "ImageUploadMaxBytes": 5242880,
      "ImageMaxWidth": 320,
      "ImageMaxHeight": 240,
      "ImageDecodeMaxDimension": 10000,
      "ImageDecodeMaxPixels": 16000000,
      "ImageProcessingConcurrency": 2,
      "TextFileMaxBytes": 102400
    },
    "Captcha": {
      "LifetimeSeconds": 300,
      "Capacity": 2048,
      "CodeLength": 6,
      "Alphabet": "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
    },
    "Requests": {
      "JsonMaxBytes": 1048576,
      "JsonMaxDepth": 16,
      "BodyMaxBytes": 6291456,
      "MultipartMaxBytes": 5242880,
      "FormValueMaxLength": 262144,
      "FormValueCountLimit": 16,
      "HealthTimeoutSeconds": 2
    },
    "GraphQL": {
      "Enabled": true,
      "MaximumRequestBytes": 32768,
      "MaximumDepth": 8,
      "MaximumFields": 256,
      "MaximumFieldCost": 1000,
      "MaximumTypeCost": 2000,
      "ExecutionTimeoutSeconds": 10,
      "MaximumConcurrentRequests": 16
    },
    "Broker": {
      "Enabled": false,
      "Host": "broker",
      "Port": 5672,
      "Username": "comments_app",
      "Exchange": "commentsservice.comments.v1",
      "Capacity": 128,
      "OperationTimeoutSeconds": 2,
      "ReconnectDelayMilliseconds": 2000,
      "FallbackDelayMilliseconds": 1000
    }
  }
}
